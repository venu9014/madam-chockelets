# =====================================================================
# Madam Chockelets Operations Platform - Production Environment Configuration
# =====================================================================

# ---------------------------------------------------------------------
# 1. DATABASE CONNECTION (Required)
# ---------------------------------------------------------------------
# For Vercel Serverless Production: Use a managed PostgreSQL database 
# (e.g. Neon, Supabase, Vercel Postgres, AWS RDS, Railway, Aiven).
# Example format:
# postgresql://[user]:[password]@[neon-hostname].neon.tech/[dbname]?sslmode=require
DATABASE_URL="postgresql://user:password@hostname:5432/madam_chockelets?sslmode=require"

# If using Vercel Postgres / Neon integration:
# POSTGRES_PRISMA_URL="postgres://..."

# ---------------------------------------------------------------------
# 2. SESSION AUTHENTICATION & SECURITY (Required)
# ---------------------------------------------------------------------
# 256-bit cryptographically secure secret used to sign session JWTs.
# Generate via: openssl rand -base64 32
JWT_SECRET="replace-with-a-secure-random-32-byte-hex-secret-in-production"

# ---------------------------------------------------------------------
# 3. RUNTIME & APPLICATION ENVIRONMENT (Required)
# ---------------------------------------------------------------------
NODE_ENV="production"
NEXT_PUBLIC_APP_ENV="production"

# ---------------------------------------------------------------------
# 4. BRANDING & LOCALIZATION
# ---------------------------------------------------------------------
NEXT_PUBLIC_APP_NAME="Madam Chockelets"
NEXT_PUBLIC_DEFAULT_CURRENCY="INR"
NEXT_PUBLIC_TIMEZONE="Asia/Kolkata"

# ---------------------------------------------------------------------
# 5. DEMO PERSONA SWITCHER
# ---------------------------------------------------------------------
# Set to "false" for strict production security, or "true" for client demonstration.
NEXT_PUBLIC_DEMO_MODE="true"
