# Madam Chocolate Digital Operations Platform - Environment Template
# Copy this file to .env and provide production-grade credentials for deployment

# Database Connection (SQLite for local zero-config development; PostgreSQL for production)
DATABASE_URL="file:./dev.db"

# Session / Authentication Secret (Must be high-entropy 256-bit secret in production)
JWT_SECRET="replace-with-a-secure-random-32-byte-hex-secret-in-production"

# Application Environment (development | staging | production)
NODE_ENV="development"
NEXT_PUBLIC_APP_ENV="development"

# Localization & Business Conventions
NEXT_PUBLIC_APP_NAME="MADAM CHOCOLATE — Digital Operations Platform"
NEXT_PUBLIC_DEFAULT_CURRENCY="INR"
NEXT_PUBLIC_TIMEZONE="Asia/Kolkata"

# Demo Mode Configuration (Must be set to false in production)
NEXT_PUBLIC_DEMO_MODE="true"
