{
  "name": "madam-chocolate-ops",
  "version": "1.0.0",
  "private": true,
  "description": "Madam Chocolate Digital Operations Platform - Centralized Multi-Branch Operations, Inventory, SOPs, and Attendance",
  "scripts": {
    "dev": "next dev",
    "build": "node scripts/prepare-prisma.mjs && prisma generate && next build",
    "vercel-build": "node scripts/prepare-prisma.mjs && prisma generate && next build",
    "start": "next start",
    "lint": "next lint",
    "prisma:generate": "prisma generate",
    "prisma:push": "node scripts/prepare-prisma.mjs && prisma db push",
    "prisma:seed": "node scripts/seed-production.mjs",
    "prisma:reset": "node scripts/reset-demo.mjs",
    "db:export": "node scripts/export-data.mjs",
    "db:seed": "node scripts/seed-production.mjs",
    "db:push": "node scripts/prepare-prisma.mjs && prisma db push",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage"
  },
  "dependencies": {
    "@prisma/client": "^5.21.1",
    "bcryptjs": "^2.4.3",
    "clsx": "^2.1.1",
    "date-fns": "^3.6.0",
    "jsonwebtoken": "^9.0.2",
    "lucide-react": "^0.453.0",
    "next": "^14.2.25",
    "papaparse": "^5.4.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "recharts": "^2.13.0",
    "tailwind-merge": "^2.5.4",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/jsonwebtoken": "^9.0.7",
    "@types/node": "^20.17.0",
    "@types/papaparse": "^5.3.14",
    "@types/react": "^18.3.11",
    "@types/react-dom": "^18.3.1",
    "autoprefixer": "^10.4.20",
    "postcss": "^8.4.47",
    "prisma": "^5.21.1",
    "tailwindcss": "^3.4.14",
    "typescript": "^5.6.3",
    "vitest": "^2.1.3"
  }
}
